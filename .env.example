# Copia este fichero a `.env` y rellena lo que vayas a usar.
# NO subas el .env a GitHub: contiene tus claves.

# ---------------------------------------------------------------------------
# WhatsApp: canal principal (Green API) — es el único que envía a GRUPOS
# ---------------------------------------------------------------------------
# Regístrate en https://green-api.com, crea una instancia y vincula tu
# WhatsApp escaneando el QR. Luego mira el README para sacar el ID del grupo.
# Cada instancia tiene SU PROPIA URL, que aparece como "apiUrl" en el panel
# (p. ej. https://1234.api.greenapi.com, con TU número). La genérica falla.
GREEN_API_URL=https://api.green-api.com
GREEN_API_INSTANCIA=
GREEN_API_TOKEN=
# Formato de grupo:   34600111222-1581234048@g.us
# Formato personal:   34600111222@c.us
GREEN_API_CHAT=

# ---------------------------------------------------------------------------
# WhatsApp: respaldo (CallMeBot) — SOLO chats personales, no grupos
# ---------------------------------------------------------------------------
# Añade +34 621 331 709 a contactos y mándale por WhatsApp:
#   "I allow callmebot to send me messages"
# Te responde con tu API key.
CALLMEBOT_TELEFONO=+34600111222
CALLMEBOT_KEY=

# ---------------------------------------------------------------------------
# Fuentes opcionales (el programa funciona sin ellas, con 3 fuentes gratis)
# ---------------------------------------------------------------------------
# Stormglass: segunda opinión de oleaje. Gratis ~10 peticiones/día.
# https://stormglass.io
STORMGLASS_KEY=

# AEMET: boletín marítimo oficial. Clave gratis en
# https://opendata.aemet.es/centrodedescargas/altaUsuario
AEMET_KEY=
# Zona costera de AEMET (41 = litoral balear). Cámbialo si el boletín no cuadra.
AEMET_COSTA=41

# MET Norway exige identificarse. Pon algo que te identifique de verdad.
CONTACTO=vigia-jetski/1.0 (tucorreo@ejemplo.com)

# ---------------------------------------------------------------------------
# Ubicación (por defecto, Cala Tarida)
# ---------------------------------------------------------------------------
LATITUD=38.9469
LONGITUD=1.2264
LUGAR=Cala Tarida (Ibiza)
ZONA_HORARIA=Europe/Madrid

# Sector de "viento de mar", en grados, de dónde VIENE el viento.
# Cala Tarida mira al oeste: de SSO (202.5) a NNO (337.5) entra la mar.
SECTOR_MAR_DESDE=202.5
SECTOR_MAR_HASTA=337.5

# ---------------------------------------------------------------------------
# Umbrales de aviso — ajústalos a tu moto y a tu amarre
# ---------------------------------------------------------------------------
OLA_AMARILLO=0.5
OLA_NARANJA=0.9
OLA_ROJO=1.5

RACHA_AMARILLO=18
RACHA_NARANJA=25
RACHA_ROJO=35

# ---------------------------------------------------------------------------
# Comportamiento
# ---------------------------------------------------------------------------
HORAS_VISTA=12          # cuántas horas por delante se vigilan
NIVEL_MINIMO_AVISO=2    # 1=AMARILLO 2=NARANJA 3=ROJO
SILENCIAR_HORAS=6       # no repetir el mismo aviso antes de N horas
PARTE_DIARIO=false      # true = mandar parte siempre, aunque esté en verde
